# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address for contact-form notifications.
# Must be on a domain verified in your Resend account (https://resend.com/domains).
# Until a domain is verified, leave unset to fall back to Resend's shared
# onboarding@resend.dev sender (works for testing, not for production).
CONTACT_FROM_EMAIL=
